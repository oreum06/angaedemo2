  "stage": {
    "S01:0": {
      "caption": "덜컹이는 시골 버스. 창밖으로 노을 진 산길이 지나간다."
    },
    "S01:1": {
      "phone": [
        {
          "from": "채용 알림",
          "text": "지원하신 채용 공고의 전형이 종료되었습니다."
        },
        {
          "from": "친구",
          "text": "포미야 잘 지내? 나 다음 달부터 출근해 ㅎㅎ 시간 되면 밥 먹자!"
        }
      ],
      "caption": "휴대전화 알림이 연달아 뜬다."
    },
    "S01:3": {
      "typing": {
        "to": "친구",
        "draft": "축하해!! 정말 잘됐다!",
        "sent": "축하해. 고생 많았어. 시간 맞으면 밥 먹자."
      },
      "caption": "포미가 답장을 썼다가 지우고, 다시 쓴다."
    },
    "S01:9": {
      "compass": "sway",
      "caption": "황동 나침반의 바늘이 흔들린다."
    },
    "S01:15": {
      "fade": true
    },
    "S02:2": {
      "enter": "karuviya",
      "caption": "감과 채소, 화분이 담긴 커다란 바구니를 든 할머니가 다가온다."
    },
    "S02:11": {
      "caption": "바구니를 받아 든 포미가 무게에 살짝 휘청한다.",
      "expr": {
        "karuviya": "laugh"
      }
    },
    "S03:2": {
      "caption": "할머니가 높은 선반의 주전자로 손을 뻗자, 포미가 달려온다."
    },
    "S03:7": {
      "caption": "물통을 들면 달려오고, 화분을 옮기려 하면 또 달려오고."
    },
    "S03:17": {
      "caption": "할머니가 다시 낮은 의자에 올라선다."
    },
    "S03:21": {
      "caption": "포미가 빨간 상자를 꺼낸다. 낡은 사진과 장신구가 들어 있다."
    },
    "S03:26": {
      "caption": "따뜻한 차와 감이 나온다.",
      "expr": {
        "karuviya": "tea"
      }
    },
    "S03:36": {
      "caption": "성큼성큼 앞서 걷는 할머니. 바구니를 든 채 허둥지둥 따라가는 포미.",
      "expr": {
        "karuviya": "basket"
      },
      "fadeAfter": true
    },
    "S04:0": {
      "caption": "딸랑 — 경쾌한 빵집 문종이 울린다."
    },
    "S04:17": {
      "caption": "딸랑 — 어린 손님이 보호자의 손을 잡고 들어온다."
    },
    "S04:22": {
      "caption": "아이가 까르르 웃고, 마루도 덩달아 신이 난다. 아이와 보호자가 가게를 나선다."
    },
    "S05:0": {
      "caption": "창가에서 빵을 먹는 포미. 문종이 울리고 카루비야 할머니가 들어온다.",
      "enter": "karuviya"
    },
    "S05:9": {
      "caption": "빨간 상자에서 마루의 어린 시절 사진이 나온다."
    },
    "S05:15": {
      "hush": 1400
    },
    "S05:29": {
      "caption": "따르릉 — 빵집 전화가 울린다. 마루가 주문 수첩을 펼친다."
    },
    "S06:2": {
      "caption": "나무 다리 위. 돌과 나뭇잎, 나뭇가지로 만든 무언가가 바닥에 펼쳐져 있다."
    },
    "S06:42": {
      "caption": "소렌이 손을 흔들며 떠난다. 바람에 나뭇잎 하나가 날린다.",
      "exit": "soren"
    },
    "S07:0": {
      "caption": "나무판자와 끈으로 장식을 만드는 소렌.",
      "enter": "soren"
    },
    "S07:27": {
      "caption": "주민이 돌아가고, 잠깐 정적이 흐른다."
    },
    "S07:36": {
      "caption": "두 사람이 나란히 앉아 끈으로 장식을 묶는다."
    },
    "S07:71": {
      "caption": "완성된 장식이 바람에 흔들린다.",
      "fadeAfter": true
    },
    "S08:0": {
      "caption": "똑, 똑 — 나무를 두드리는 소리가 들린다."
    },
    "S08:11": {
      "caption": "반듯한 의자, 정교한 선반. 공방 가득 목공 작품이 놓여 있다."
    },
    "S08:34": {
      "caption": "선반 위, 어딘가 우스꽝스러운 나무 새 한 마리."
    },
    "S09:11": {
      "caption": "아저씨가 선반에서 실패작 나무 새들을 줄줄이 꺼낸다."
    },
    "S09:18": {
      "caption": "부리가 큰 새가 서 있지 못하고 앞으로 고꾸라진다. 툭. 툭.",
      "nudge": true
    },
    "S09:23": {
      "caption": "아저씨가 자리를 비운 사이, 선반을 정리하던 포미의 손에서 나무 새가 떨어진다. 딸깍.",
      "exit": "woodpecker",
      "nudge": true
    },
    "S09:35": {
      "caption": "두 사람이 날개를 붙인다. 날개가 전보다 조금 위를 향해 붙는다."
    },
    "S09:54": {
      "caption": "사각, 사각. 나무 깎는 소리만 남는다.",
      "fadeAfter": true
    },
    "S10:0": {
      "caption": "나뭇잎 장식과 빵, 주민들과 아이들로 북적이는 광장. 포미는 입구에서 망설인다."
    },
    "S10:17": {
      "caption": "광장 위로 포미와 소렌이 묶은 노란 장식이 흔들린다."
    },
    "S10:26": {
      "caption": "할머니가 커다란 주전자를 들고 나타난다.",
      "enter": "karuviya",
      "expr": {
        "karuviya": "tea"
      }
    },
    "S10:37": {
      "caption": "날개가 위로 치켜 붙은 나무 새를 아저씨가 건넨다."
    },
    "S10:46": {
      "caption": "빵을 내미는 마루, 손짓하며 떠드는 소렌, 차를 따르는 할머니, 빵을 먹는 아저씨. 포미는 입을 가리지 않고 웃는다.",
      "fadeAfter": true
    },
    "S11:0": {
      "caption": "정류장 벤치. 포미가 휴대전화로 채용 공고를 보고 있다."
    },
    "S11:2": {
      "compass": "sway",
      "caption": "바늘이 느리게 흔들린다."
    },
    "S11:4": {
      "phone": [
        {
          "from": "친구",
          "text": "시간 되면 밥 먹자!"
        }
      ],
      "typing": {
        "to": "친구",
        "sent": "나 이번에 여행 왔어. 돌아가면 밥 먹자. 나 너한테 할 얘기 좀 있어 ㅎㅎ"
      },
      "caption": "포미가 친구에게 답장을 보낸다."
    },
    "S11:14": {
      "caption": "할머니가 감 하나를 건넨다."
    },
    "S11:18": {
      "caption": "할머니가 바구니를 든다. 포미가 반사적으로 몸을 기울인다.",
      "expr": {
        "karuviya": "basket"
      }
    },
    "S11:23": {
      "caption": "할머니가 씩씩하게 걸어간다. 포미는 그 뒷모습을 바라본다.",
      "exit": "karuviya"
    },
    "S11:25": {
      "caption": "멀리서 버스가 온다. 포미가 가방에서 고친 나무 새를 꺼낸다."
    },
    "S11:29": {
      "compass": "settle",
      "caption": "버스 안. 포미의 손 위에서 나침반 바늘이 잠시 한 방향을 가리킨다. 포미는 알아채지 못한다."
    },
    "S11:31": {
      "end": {
        "title": "안개골: 바람나침반",
        "line": "오늘은 여기까지.",
        "mark": "DEMO END"
      }
    }
